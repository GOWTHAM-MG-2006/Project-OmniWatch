# OmniWatch agent — environment variable overrides (Task T2)
# Copy to .env and adjust. Every OMNIWATCH_* var overrides its YAML counterpart.

# Agent
OMNIWATCH_AGENT_COLLECTION_INTERVAL=60s
OMNIWATCH_AGENT_LOG_LEVEL=info

# Receiver — hostmetrics
OMNIWATCH_RECEIVER_HOSTMETRICS_COLLECTION_INTERVAL=60s

# Receiver — filelog (comma-separated list)
OMNIWATCH_RECEIVER_FILELOG_INCLUDE=/var/log/*.log

# Receiver — k8s_objects
OMNIWATCH_RECEIVER_K8S_OBJECTS_COLLECTION_INTERVAL=15m
OMNIWATCH_RECEIVER_K8S_OBJECTS_MODE=pull
OMNIWATCH_RECEIVER_K8S_OBJECTS_LABEL_SELECTOR=
OMNIWATCH_RECEIVER_K8S_OBJECTS_FIELD_SELECTOR=

# Receiver — k8s_cluster (comma-separated list)
OMNIWATCH_RECEIVER_K8S_CLUSTER_COLLECTION_INTERVAL=10m
OMNIWATCH_RECEIVER_K8S_CLUSTER_NODE_CONDITIONS_TO_REPORT=Ready,MemoryPressure,DiskPressure,PIDPressure,NetworkUnavailable

# Exporter — OTLP
OMNIWATCH_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
OMNIWATCH_EXPORTER_OTLP_INSECURE=true
