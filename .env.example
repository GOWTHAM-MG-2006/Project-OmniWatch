# ==============================================================================
# OmniWatch — Environment Configuration
# ==============================================================================

# --- Network ---
NETWORK_NAME=omniwatch-network

# --- Kafka ---
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka Topics (used by ingestion layer)
KAFKA_TOPIC_METRICS_RAW=omniwatch.metrics.raw
KAFKA_TOPIC_LOGS_RAW=omniwatch.logs.raw
KAFKA_TOPIC_TRACES_RAW=omniwatch.traces.raw
KAFKA_TOPIC_SECURITY_EVENTS=omniwatch.security.events
KAFKA_TOPIC_NORMALIZED_METRICS=omniwatch.metrics.normalized
KAFKA_TOPIC_NORMALIZED_LOGS=omniwatch.logs.normalized
KAFKA_TOPIC_NORMALIZED_TRACES=omniwatch.traces.normalized
KAFKA_TOPIC_ENTITIES_RESOLVED=omniwatch.entities.resolved
KAFKA_TOPIC_RELATIONSHIPS=omniwatch.entities.relationships
KAFKA_TOPIC_FEATURES=omniwatch.features.*
KAFKA_TOPIC_ANOMALIES=omniwatch.anomalies.detected
KAFKA_TOPIC_INCIDENTS=omniwatch.incidents.created
KAFKA_TOPIC_INCIDENTS_CAUSAL=omniwatch.incidents.causal
KAFKA_TOPIC_ACTIONS=omniwatch.remediation.actions

# --- ClickHouse ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=9000
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=omniwatch
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Neo4j ---
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=omniwatch

# --- MinIO ---
MINIO_HOST=minio
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_TELEMETRY=omniwatch-telemetry-archive
MINIO_BUCKET_INCIDENTS=omniwatch-incidents
MINIO_BUCKET_AUDIT=omniwatch-audit-logs
MINIO_BUCKET_ML=omniwatch-ml-datasets
MINIO_BUCKET_RUNBOOKS=omniwatch-runbooks

# --- Prometheus ---
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090

# --- Loki ---
LOKI_HOST=loki
LOKI_PORT=3100

# --- Jaeger ---
JAEGER_HOST=jaeger
JAEGER_UI_PORT=16686
JAEGER_GRPC_PORT=4317
JAEGER_HTTP_PORT=4318

# --- Redis (Feature Store / Dedup Cache) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- OPA ---
OPA_HOST=opa
OPA_PORT=8181
OPA_URL=http://opa:8181

# --- Ollama ---
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL_PERFORMANCE=llama3.2:3b
OLLAMA_MODEL_QUALITY=qwen2.5:7b

# --- FastAPI Services ---
INGESTION_HOST=0.0.0.0
INGESTION_PORT=8001
DASHBOARD_API_HOST=0.0.0.0
DASHBOARD_API_PORT=8000

# --- OTel Collector ---
OTEL_COLLECTOR_HOST=otel-collector
OTEL_COLLECTOR_PORT_GRPC=4317
OTEL_COLLECTOR_PORT_HTTP=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- GCP ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GKE_CLUSTER_NAME=omniwatch-cluster
GKE_NUM_NODES=1

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Python ---
PYTHONPATH=/app