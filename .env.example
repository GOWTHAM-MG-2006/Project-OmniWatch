# ==============================================================================
# OmniWatch — Environment Configuration
# ==============================================================================

# --- Network ---
NETWORK_NAME=omniwatch-network

# --- Kafka ---
KAFKA_HOST=kafka
KAFKA_PORT=9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka Topics (used by ingestion layer)
KAFKA_TOPIC_METRICS_RAW=omniwatch.metrics.raw
KAFKA_TOPIC_LOGS_RAW=omniwatch.logs.raw
KAFKA_TOPIC_TRACES_RAW=omniwatch.traces.raw
KAFKA_TOPIC_SECURITY_EVENTS=omniwatch.security.events
KAFKA_TOPIC_NORMALIZED_METRICS=omniwatch.metrics.normalized
KAFKA_TOPIC_NORMALIZED_LOGS=omniwatch.logs.normalized
KAFKA_TOPIC_NORMALIZED_TRACES=omniwatch.traces.normalized
KAFKA_TOPIC_ENTITIES_RESOLVED=omniwatch.entities.resolved
KAFKA_TOPIC_RELATIONSHIPS=omniwatch.entities.relationships
KAFKA_TOPIC_FEATURES=omniwatch.features.*
KAFKA_TOPIC_ANOMALIES=omniwatch.anomalies.detected
KAFKA_TOPIC_INCIDENTS=omniwatch.incidents.created
KAFKA_TOPIC_INCIDENTS_CAUSAL=omniwatch.incidents.causal
KAFKA_TOPIC_ACTIONS=omniwatch.remediation.actions

# --- ClickHouse ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_DB=omniwatch
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# --- Neo4j ---
NEO4J_HOST=neo4j
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=omniwatch

# --- MinIO ---
MINIO_HOST=minio
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_TELEMETRY=omniwatch-telemetry-archive
MINIO_BUCKET_INCIDENTS=omniwatch-incidents
MINIO_BUCKET_AUDIT=omniwatch-audit-logs
MINIO_BUCKET_ML=omniwatch-ml-datasets
MINIO_BUCKET_RUNBOOKS=omniwatch-runbooks

# --- Prometheus ---
PROMETHEUS_HOST=prometheus
PROMETHEUS_PORT=9090

# --- Loki ---
LOKI_HOST=loki
LOKI_PORT=3100

# --- Jaeger ---
JAEGER_HOST=jaeger
JAEGER_UI_PORT=16686
JAEGER_GRPC_PORT=4317
JAEGER_HTTP_PORT=4318

# --- Redis (Feature Store / Dedup Cache) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- OPA ---
OPA_HOST=opa
OPA_PORT=8181
OPA_URL=http://opa:8181

# --- Ollama ---
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL_PERFORMANCE=llama3.2:3b
OLLAMA_MODEL_QUALITY=qwen2.5:7b

# --- FastAPI Services ---
INGESTION_HOST=0.0.0.0
INGESTION_PORT=8001
DASHBOARD_API_HOST=0.0.0.0
DASHBOARD_API_PORT=8000

# --- Predictive Intelligence (Phase 6) ---
# Service
PREDICTIVE_PORT=8007

# Kafka consumer group for the predictive layer
PREDICTIVE_KAFKA_GROUP_ID=predictive

# Anomaly detection thresholds
PREDICTIVE_ANOMALY_THRESHOLD=0.7
PREDICTIVE_ANOMALY_SCORE_THRESHOLD=0.7
PREDICTIVE_SECURITY_CONFIDENCE_THRESHOLD=80.0
PREDICTIVE_CONFIDENCE_THRESHOLD=60.0

# Feature windowing
PREDICTIVE_WINDOW_SIZE=300
PREDICTIVE_LOOKBACK_WINDOW=168
PREDICTIVE_SEASONALITY_PERIOD=24
PREDICTIVE_NOISE_FILTER_WINDOW=5

# Model management
PREDICTIVE_COLD_START_SAMPLE_COUNT=30
PREDICTIVE_MODEL_UPDATE_INTERVAL=3600

# Security signal classifier (GAP-1)
PREDICTIVE_SECURITY_ENABLED=true

# --- OTel Collector ---
OTEL_COLLECTOR_HOST=otel-collector
OTEL_COLLECTOR_PORT_GRPC=4317
OTEL_COLLECTOR_PORT_HTTP=4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# --- GCP ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
GKE_CLUSTER_NAME=omniwatch-cluster
GKE_NUM_NODES=1

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Python ---
PYTHONPATH=/app

# LLM Provider Settings (managed via Settings page)
# Providers: ollama_local, ollama_cloud, openrouter, groq
LLM_PROVIDER=ollama_local
LLM_API_KEY=
LLM_MODEL=qwen3:8b

# --- OMNIWATCH_* dynamic config (DYN lanes) ---
# Canonical record for every dynamic variable the Python/Go lanes implement.
# Each entry keeps today's dev default so `docker compose up -d` boots unchanged;
# prod injects via environment/secret. MinIO ports: OMNIWATCH_MINIO_ENDPOINT is
# the single truth (host:api-port); bare MINIO_HOST/MINIO_API_PORT above are
# deprecated, still honored. Old GCP_PROJECT_ID placeholder retired — use
# OMNIWATCH_GCP_PROJECT_ID (empty = must inject, no fake default).

# Core endpoints
OMNIWATCH_KAFKA_BOOTSTRAP_SERVERS=kafka:29092 # internal listener (compose); external clients use localhost:9092
OMNIWATCH_CLICKHOUSE_HOST=clickhouse # ClickHouse service host
OMNIWATCH_CLICKHOUSE_HTTP_PORT=8123 # HTTP interface (health + queries)
OMNIWATCH_CLICKHOUSE_NATIVE_PORT=9000 # native TCP protocol port
OMNIWATCH_CLICKHOUSE_DB=omniwatch # analytics database
OMNIWATCH_CLICKHOUSE_PASSWORD= # empty dev default (matches compose)
OMNIWATCH_CLICKHOUSE_TIMEZONE=UTC # canonical timestamp timezone
OMNIWATCH_NEO4J_URI=bolt://neo4j:7687 # causal graph Bolt endpoint
OMNIWATCH_NEO4J_PASSWORD=omniwatch # neo4j user password (NEO4J_AUTH=neo4j/<this>)
OMNIWATCH_MINIO_ENDPOINT=minio:9010 # single endpoint truth (S3 API)
OMNIWATCH_MINIO_ACCESS_KEY=minioadmin # S3 access key (mirrors MINIO_ROOT_USER)
OMNIWATCH_MINIO_SECRET_KEY=minioadmin # S3 secret key (mirrors MINIO_ROOT_PASSWORD)
OMNIWATCH_MINIO_CONSOLE_PORT=9001 # web console port
OMNIWATCH_OPA_URL=http://opa:8181 # policy decision endpoint
OMNIWATCH_LLM_URL=http://ollama:11434 # LLM runtime base URL
OMNIWATCH_LLM_MODEL=qwen3:8b # default chat/summary model (kept resident)
OMNIWATCH_LLM_MAX_TOKENS=2048 # per-request completion cap
OMNIWATCH_LLM_TEMPERATURE=0.2 # low temp for grounded, factual output
OMNIWATCH_LLM_CONCURRENCY=4 # parallel generation slots
OMNIWATCH_VLLM_BASE=http://localhost:8000 # optional vLLM OpenAI-compatible base
OMNIWATCH_LEARNING_URL=http://learning:8030 # continuous learning service
OMNIWATCH_GENAI_URL=http://genai:8020 # NOTE: compose service is genai-service; sibling lanes to resolve hostname
OMNIWATCH_ORCHESTRATION_URL=http://orchestration:8010 # NOTE: compose service is orchestration-engine; sibling lanes to resolve hostname
OMNIWATCH_SIMULATION_ENDPOINT=http://localhost:8080 # OTel demo frontend (anomaly injector target)

# Service ports (mirror compose `ports:` left-hand sides)
OMNIWATCH_PREDICTIVE_PORT=8007 # anomaly detection API
OMNIWATCH_CAUSAL_PORT=8008 # root-cause engine API
OMNIWATCH_PRIORITIZATION_PORT=8009 # incident prioritization API
OMNIWATCH_ORCHESTRATION_PORT=8010 # orchestration engine API
OMNIWATCH_DASHBOARD_PORT=8011 # dashboard backend API
OMNIWATCH_GENAI_PORT=8020 # GenAI service API
OMNIWATCH_LEARNING_PORT=8030 # learning service API
OMNIWATCH_FEATURE_STORE_PORT=8005 # feature retrieval sidecar API

# Model + rules paths
OMNIWATCH_MODEL_PATH=/app/models # local model weights dir (sibling lanes mount)
OMNIWATCH_OPA_RULES_PATH=./orchestration/policies # OPA .rego bundle (compose mount)
OMNIWATCH_SECURITY_RULES_PATH=./predictive/security/rules # GAP-1 classifier rules
OMNIWATCH_DEDUP_RULES_PATH=./prioritization/rules # GAP-3 dedup grouping rules
OMNIWATCH_SLA_RULES_PATH=./prioritization/sla_rules # severity -> SLA mapping rules
OMNIWATCH_MODEL_SETTINGS_PATH=/app/.omniwatch/model-settings.json # dashboard-managed LLM settings
OMNIWATCH_SIM_LOG_PATH=/var/log/omniwatch/simulation.log # simulation fallback log tail

# Cloud defaults
OMNIWATCH_DEFAULT_CLOUD_PROVIDER=gcp # simulation-first cloud label
OMNIWATCH_DEFAULT_REGION=us-central1 # default region label
OMNIWATCH_GCP_PROJECT_ID= # no default — prod must inject (placeholder retired)
OMNIWATCH_GCP_REGION=us-central1 # GKE deployment region

# Threshold aliases (code lanes read OMNIWATCH_*; bare names deprecated, still honored)
PREDICTIVE_ANOMALY_SCORE_THRESHOLD=0.5 # anomaly score gate (compose truth)
PREDICTIVE_CONFIDENCE_THRESHOLD=60.0 # min confidence to emit signal
SECURITY_CONFIDENCE_THRESHOLD=80.0 # GAP-1 security signal gate
SECURITY_ENABLED=true # GAP-1 classifier on/off
CAUSAL_MAX_DEPTH=10 # DAG traversal depth cap
CAUSAL_MIN_CONFIDENCE=0.3 # root-cause accept floor
DEDUP_TTL_SECONDS=300 # GAP-3 active-incident window
DEDUP_ENABLED=true # GAP-3 dedup on/off
SLA_P1_RESPONSE_MINUTES=15 # P1 response objective
SLA_P2_RESPONSE_MINUTES=60 # P2 response objective
SLA_P3_RESPONSE_MINUTES=240 # P3 response objective
SLA_P4_RESPONSE_MINUTES=1440 # P4 response objective
OPA_TIMEOUT_SECONDS=5 # policy query timeout
OPA_FALLBACK_ALLOW=false # deny on OPA unreachable (fail-closed)
ORCH_TIMEOUT_SECONDS=30 # single action timeout
ORCH_MAX_RETRIES=3 # remediation retry cap
LLM_MAX_TOKENS=2048 # alias of OMNIWATCH_LLM_MAX_TOKENS
LLM_TEMPERATURE=0.2 # alias of OMNIWATCH_LLM_TEMPERATURE

# Agent knobs (omniwatch-agent/configs/agent.yaml defaults; flag > env > yaml)
HEALTH_ADDR=:8080 # health probe listen address
BEYLA_OTLP_ENDPOINT=otelcol:4317 # Beyla trace export (grpc, scheme set in beyla-config)
OMNIWATCH_AGENT_COLLECTION_INTERVAL=60s # heartbeat/self-telemetry tick
OMNIWATCH_AGENT_LOG_LEVEL=info # agent log level
OMNIWATCH_EXPORTER_OTLP_ENDPOINT=otelcol:4317 # agent OTLP target (compose service name)
OMNIWATCH_EXPORTER_OTLP_INSECURE=true # plaintext gRPC in dev
OMNIWATCH_RECEIVER_FILELOG_INCLUDE=/var/log/pods/*/*/*.log,/var/log/containers/*/*.log,/var/log/kubernetes/audit/*.log # filelog globs
OMNIWATCH_RECEIVER_HOSTMETRICS_COLLECTION_INTERVAL=15s # hostmetrics tick
OMNIWATCH_RECEIVER_K8S_OBJECTS_COLLECTION_INTERVAL=30s # k8s objects poll tick
OMNIWATCH_RECEIVER_K8S_OBJECTS_MODE=watch # k8s objects watch|pull
OMNIWATCH_RECEIVER_K8S_CLUSTER_COLLECTION_INTERVAL=60s # k8s cluster tick
OMNIWATCH_RESILIENCE_CIRCUIT_BREAKER_THRESHOLD=5 # breaker trip count
OMNIWATCH_RESILIENCE_CIRCUIT_BREAKER_TIMEOUT=30s # breaker open duration
OMNIWATCH_RESILIENCE_QUEUE_SIZE=1000 # bounded heartbeat queue
OMNIWATCH_RESILIENCE_RETRY_MAX_ATTEMPTS=3 # export retry cap
OMNIWATCH_RESILIENCE_RETRY_BASE_DELAY=100ms # retry base (100ms->500ms->2s)
OMNIWATCH_AUTH_MODE=dev # dev|apikey|mtls (compose uses dev)
OMNIWATCH_TLS_TRUST_DOMAIN=example.org # SPIRE trust domain
OMNIWATCH_TLS_SPIFFE_SOCKET_PATH=unix:///tmp/spire-agent/public/api.sock # SPIRE workload socket
OMNIWATCH_TLS_CERT_ROTATION_INTERVAL=24h # SVID rotation period
OMNIWATCH_LEADER_ELECTION_ENABLED=false # singleton daemon gating
OMNIWATCH_LEADER_ELECTION_LEASE_DURATION=15 # k8s Lease hold seconds
OMNIWATCH_SLO_AVAILABILITY_TARGET=99.9 # /health availability SLO %
OMNIWATCH_SLO_EXPORT_SUCCESS_TARGET=99.0 # OTLP export success SLO %
OMNIWATCH_SLO_EXPORT_LATENCY_P99_SECONDS=5 # export latency SLO
OMNIWATCH_ALERT_RULES_PATH=./omniwatch-agent/configs/alerts/prometheusrules.yaml # PrometheusRule source
# --- end OMNIWATCH_* dynamic config (DYN lanes) ---
